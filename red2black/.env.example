# SMTP Email Configuration
# Use Gmail, Office 365, or your hosting provider's SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Owner email - booking/enquiry notifications are sent here
OWNER_EMAIL=bookings@red2black.co.uk

# Site URL (used in email templates)
NEXT_PUBLIC_SITE_URL=https://red2black.co.uk
